# Neon Postgres pooled connection URL for application runtime queries
DATABASE_URL="postgresql://user:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres direct unpooled connection URL for Prisma migrations and schema updates
DIRECT_URL="postgresql://user:password@ep-direct.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob read/write access token for contract document uploads
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Secret API key for OpenAI or any OpenAI-compatible model provider
AI_API_KEY="sk-..."

# Base URL endpoint for OpenAI-compatible API requests
AI_BASE_URL="https://api.openai.com/v1"

# Primary AI model name for contract analysis and citation extraction
AI_MODEL="gpt-4o"

# Optional fast AI model name for classification, indexing, and small summaries
AI_FAST_MODEL="gpt-4o-mini"

# Optional maximum character budget for contract context prompts
AI_MAX_CONTEXT_CHARS="120000"
